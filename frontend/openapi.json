{
  "openapi": "3.1.1",
  "info": {
    "title": "respawn",
    "version": "dev"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "tags": [
          "Config"
        ],
        "summary": "What the sign-in page may offer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create a local account and sign in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with a local account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oidc": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with an ID token from a configured provider",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OidcRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OidcRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OidcRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out of this browser",
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "The signed-in account",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "tags": [
          "Library"
        ],
        "summary": "The games the signed-in account owns",
        "description": "One item per game, with the store entries it is owned through. Read it in parts with offset and limit; total says how many games there are in all.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "The order: name (A to Z), playtime (the most played first) or last_played (the last played first). What an order cannot place comes last.",
            "schema": {
              "pattern": "^(name|playtime|last_played)$",
              "type": "string",
              "default": "name"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "How many games to skip, in that order.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most games to answer with.",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigResponse": {
        "required": [
          "local_sign_in",
          "registration_open",
          "first_account",
          "password_min_length",
          "oidc_providers"
        ],
        "type": "object",
        "properties": {
          "local_sign_in": {
            "type": "boolean"
          },
          "registration_open": {
            "type": "boolean"
          },
          "first_account": {
            "type": "boolean"
          },
          "password_min_length": {
            "type": "integer",
            "format": "int32"
          },
          "oidc_providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderResponse"
            }
          }
        }
      },
      "ErrorBody": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "LibraryEntryResponse": {
        "required": [
          "store_entry_id",
          "linked_account_id",
          "source",
          "external_id",
          "playtime_seconds",
          "recent_playtime_seconds",
          "last_played_at",
          "first_seen_at",
          "as_of"
        ],
        "type": "object",
        "properties": {
          "store_entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "linked_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "external_id": {
            "type": "string"
          },
          "playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "recent_playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "last_played_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LibraryGameResponse": {
        "required": [
          "game_id",
          "name",
          "playtime_seconds",
          "recent_playtime_seconds",
          "last_played_at",
          "entries"
        ],
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "recent_playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "last_played_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryEntryResponse"
            }
          }
        }
      },
      "LibraryResponse": {
        "required": [
          "total",
          "offset",
          "limit",
          "games"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryGameResponse"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "OidcRequest": {
        "required": [
          "provider",
          "id_token",
          "nonce"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "id_token": {
            "maxLength": 16384,
            "minLength": 0,
            "type": "string"
          },
          "nonce": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          }
        }
      },
      "ProviderResponse": {
        "required": [
          "name",
          "issuer",
          "client_id"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 0,
            "type": "string"
          },
          "display_name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "UserResponse": {
        "required": [
          "id",
          "email",
          "display_name",
          "is_admin"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Config"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Me"
    },
    {
      "name": "Library"
    }
  ]
}