    "/api/v1/linked-accounts/{id}/sync": {
      "post": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Read a linked account's library from its store, now",
        "description": "The library is read every day without being asked; this reads it at once, and answers when it is done, which takes the time the store takes to answer. A store that cannot be read is not an error of the request: the answer is the sync with its outcome, failed, and why. Once started, the sync goes on to its end even when the request is given up. 409 sync_in_progress: that account is being read right now. 429 too_many_requests, with Retry-After: it was read less than a minute ago. No sync takes a game out of the library: a game the store no longer lists is flagged (missing_since on its library entry).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRunResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts/steam/link": {
      "get": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Link a Steam account: sends the browser to Steam",
        "description": "A navigation from the app's own pages, not a call: the browser is sent to Steam (\"Sign in through Steam\"), which sends it back to the app once the visitor has proven a Steam account is theirs. The browser then lands on return_to with the outcome in the steam_link parameter: linked, linked_elsewhere (that Steam account is linked to another account of this instance), failed (nothing was proven) or unavailable (Steam could not be asked to confirm; trying again may work). It links a library and never opens a session.",
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "description": "The path of the app to come back to, at most 512 characters; the home when it is not one.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found",
            "content": {
              "application/json": { }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts/{id}/key": {
      "put": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Give a linked account the owner's own key of the store",
        "description": "Replaces the key the account had, if any. From then on every sync of that account reads it with this key, and only this one: a key the store refuses makes the sync fail (refused, own_key true), never a reading with the instance's key. The store is not asked here: the next sync says whether it takes the key. The key is stored encrypted and never answered. 400 invalid_key: not in the shape of the store's keys (Steam: a Steam Web API key, letters and digits). 503 keys_unavailable: this instance cannot keep a key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnKeyRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnKeyRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OwnKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
