{
  "openapi": "3.1.1",
  "info": {
    "title": "respawn",
    "version": "dev"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "tags": [
          "Config"
        ],
        "summary": "What the sign-in page may offer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create a local account and sign in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with a local account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oidc": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with an ID token from a configured provider",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OidcRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OidcRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OidcRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out of this browser",
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "The signed-in account",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "tags": [
          "Library"
        ],
        "summary": "The games the signed-in account owns",
        "description": "One item per game, with the store entries it is owned through. Read it in parts with offset and limit; total says how many games there are in all.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "The order: name (A to Z), playtime (the most played first) or last_played (the last played first). What an order cannot place comes last.",
            "schema": {
              "pattern": "^(name|playtime|last_played)$",
              "type": "string",
              "default": "name"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "How many games to skip, in that order.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most games to answer with.",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts": {
      "get": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "The store accounts linked to the signed-in account",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkedAccountsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts/{id}": {
      "delete": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Unlink a store account",
        "description": "Forgets everything that was read from it: the library it gave, its history and the store's answers. It cannot be undone; linking the same store account again starts from nothing.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts/{id}/sync": {
      "post": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Read a linked account's library from its store, now",
        "description": "The library is read every day without being asked; this reads it at once, and answers when it is done, which takes the time the store takes to answer. A store that cannot be read is not an error of the request: the answer is the sync with its outcome, failed, and why. Once started, the sync goes on to its end even when the request is given up. 409 sync_in_progress: that account is being read right now. 429 too_many_requests, with Retry-After: it was read less than a minute ago. No sync takes a game out of the library: a game the store no longer lists is flagged (missing_since on its library entry).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRunResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts/steam/link": {
      "get": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Link a Steam account: sends the browser to Steam",
        "description": "A navigation from the app's own pages, not a call: the browser is sent to Steam (\"Sign in through Steam\"), which sends it back to the app once the visitor has proven a Steam account is theirs. The browser then lands on return_to with the outcome in the steam_link parameter: linked, linked_elsewhere (that Steam account is linked to another account of this instance), failed (nothing was proven) or unavailable (Steam could not be asked to confirm; trying again may work). It links a library and never opens a session.",
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "description": "The path of the app to come back to, at most 512 characters; the home when it is not one.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found",
            "content": {
              "application/json": { }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/linked-accounts/{id}/key": {
      "put": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Give a linked account the owner's own key of the store",
        "description": "Replaces the key the account had, if any. From then on every sync of that account reads it with this key, and only this one: a key the store refuses makes the sync fail (refused, own_key true), never a reading with the instance's key. The store is not asked here: the next sync says whether it takes the key. The key is stored encrypted and never answered. 400 invalid_key: not in the shape of the store's keys (Steam: a Steam Web API key, letters and digits). 503 keys_unavailable: this instance cannot keep a key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnKeyRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnKeyRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OwnKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "LinkedAccounts"
        ],
        "summary": "Take the owner's own key away from a linked account",
        "description": "The account is read with the instance's key again. Removing a key that is not there changes nothing.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigResponse": {
        "required": [
          "local_sign_in",
          "registration_open",
          "first_account",
          "password_min_length",
          "oidc_providers"
        ],
        "type": "object",
        "properties": {
          "local_sign_in": {
            "type": "boolean"
          },
          "registration_open": {
            "type": "boolean"
          },
          "first_account": {
            "type": "boolean"
          },
          "password_min_length": {
            "type": "integer",
            "format": "int32"
          },
          "oidc_providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderResponse"
            }
          }
        }
      },
      "ErrorBody": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "LibraryEntryResponse": {
        "required": [
          "store_entry_id",
          "linked_account_id",
          "source",
          "external_id",
          "playtime_seconds",
          "recent_playtime_seconds",
          "last_played_at",
          "first_seen_at",
          "as_of",
          "missing_since"
        ],
        "type": "object",
        "properties": {
          "store_entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "linked_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "external_id": {
            "type": "string"
          },
          "playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "recent_playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "last_played_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "missing_since": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "LibraryGameResponse": {
        "required": [
          "game_id",
          "name",
          "playtime_seconds",
          "recent_playtime_seconds",
          "last_played_at",
          "entries"
        ],
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "recent_playtime_seconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "last_played_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryEntryResponse"
            }
          }
        }
      },
      "LibraryResponse": {
        "required": [
          "total",
          "offset",
          "limit",
          "games"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryGameResponse"
            }
          }
        }
      },
      "LinkedAccountResponse": {
        "required": [
          "id",
          "source",
          "external_id",
          "display_name",
          "linked_at",
          "has_own_key"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "external_id": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "null",
              "string"
            ]
          },
          "linked_at": {
            "type": "string",
            "format": "date-time"
          },
          "has_own_key": {
            "type": "boolean"
          }
        }
      },
      "LinkedAccountsResponse": {
        "required": [
          "accounts"
        ],
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LinkedAccountResponse"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "OidcRequest": {
        "required": [
          "provider",
          "id_token",
          "nonce"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "id_token": {
            "maxLength": 16384,
            "minLength": 0,
            "type": "string"
          },
          "nonce": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          }
        }
      },
      "OwnKeyRequest": {
        "required": [
          "key"
        ],
        "type": "object",
        "properties": {
          "key": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ProviderResponse": {
        "required": [
          "name",
          "issuer",
          "client_id"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 0,
            "type": "string"
          },
          "display_name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "SyncRunResponse": {
        "required": [
          "id",
          "linked_account_id",
          "trigger",
          "started_at",
          "finished_at",
          "outcome",
          "error",
          "own_key"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "linked_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "trigger": {
            "type": "string"
