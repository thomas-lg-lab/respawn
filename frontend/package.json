{
  "name": "respawn",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve app",
    "build": "ng build app",
    "watch": "ng build app --watch --configuration development",
    "test": "ng test tests --no-watch",
    "gen:api": "openapi-typescript openapi.json -o packages/data/src/lib/models/api-types.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10.9.11"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.77.0",
    "@tanstack/angular-query": "5.108.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "swagger-ui-dist": "5.35.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
