<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests of the host and of the solution as a whole (the architecture rules); a module's
         tests live in the module. Starts the real app in-process, against a real PostgreSQL. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Reads the compiled assemblies to check which project depends on which. -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respawn.Host\Respawn.Host.csproj" />
    <ProjectReference Include="..\Respawn.Testing\Respawn.Testing.csproj" />
    <ProjectReference Include="..\Respawn.SharedKernel\Respawn.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Respawn.Accounts\Respawn.Accounts.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Respawn.Accounts.Api\Respawn.Accounts.Api.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Respawn.Accounts.Infrastructure\Respawn.Accounts.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games\Respawn.Games.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games.Api\Respawn.Games.Api.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games.Infrastructure\Respawn.Games.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games.Steam\Respawn.Games.Steam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
