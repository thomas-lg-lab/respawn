<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Composition only: the HTTP pipeline, and the database and the modules put together. No
       business rule lives here, and this is the only project that knows every module. -->

  <!-- The front is not built by this project: the image copies its build into wwwroot/. Without
       this, a build made while a wwwroot/ exists leaves a manifest that points at it, and the app
       no longer starts in Development once the folder is gone. -->
  <PropertyGroup>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respawn.SharedKernel\Respawn.SharedKernel.csproj" />
    <ProjectReference Include="..\Respawn.Persistence\Respawn.Persistence.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Respawn.Accounts\Respawn.Accounts.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Respawn.Accounts.Api\Respawn.Accounts.Api.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Respawn.Accounts.Infrastructure\Respawn.Accounts.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games\Respawn.Games.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games.Api\Respawn.Games.Api.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games.Infrastructure\Respawn.Games.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Games\Respawn.Games.Steam\Respawn.Games.Steam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Respawn.Tests" />
    <InternalsVisibleTo Include="Respawn.Testing" />
  </ItemGroup>

</Project>
