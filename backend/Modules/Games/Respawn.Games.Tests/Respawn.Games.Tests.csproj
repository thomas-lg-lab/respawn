<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests of the Games module: its rules and its tables, through the real app. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Respawn.Testing\Respawn.Testing.csproj" />
    <ProjectReference Include="..\Respawn.Games\Respawn.Games.csproj" />
    <ProjectReference Include="..\Respawn.Games.Api\Respawn.Games.Api.csproj" />
    <ProjectReference Include="..\Respawn.Games.Infrastructure\Respawn.Games.Infrastructure.csproj" />
    <ProjectReference Include="..\Respawn.Games.Igdb\Respawn.Games.Igdb.csproj" />
    <ProjectReference Include="..\Respawn.Games.Steam\Respawn.Games.Steam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Answers in the sources' own shape, played back in place of the sources. -->
    <None Include="Recorded\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
