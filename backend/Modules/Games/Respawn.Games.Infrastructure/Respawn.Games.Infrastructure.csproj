<Project Sdk="Microsoft.NET.Sdk">

  <!-- The outbound adapters of the Games module: its PostgreSQL schema, and the encryption of the keys
       owners give on their linked accounts. -->

  <ItemGroup>
    <ProjectReference Include="..\Respawn.Games\Respawn.Games.csproj" />
    <ProjectReference Include="..\..\..\Respawn.SharedKernel\Respawn.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- snake_case tables and columns, the PostgreSQL convention, without naming each one by hand. -->
    <PackageReference Include="EFCore.NamingConventions" Version="11.0.0" />
    <!-- Design-time only (dotnet ef migrations add): not shipped with the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- libsodium: the authenticated encryption of an owner's key, as Accounts uses it for Argon2id. -->
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Respawn.Games.Tests" />
  </ItemGroup>

</Project>
