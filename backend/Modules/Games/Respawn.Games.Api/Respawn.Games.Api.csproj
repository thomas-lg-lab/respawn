<Project Sdk="Microsoft.NET.Sdk">

  <!-- The inbound adapter of the Games module: its routes under /api/v1. It knows the module's core,
       never its infrastructure, and no other module. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Sign in through Steam" (OpenID 2.0), to link a library: the exchange with Steam and the
         check of its answer are this library's, not written by hand. -->
    <PackageReference Include="AspNet.Security.OpenId.Steam" Version="11.0.0" />
    <!-- The HTML parser that library reads Steam's discovery page with. Named here only to have a
         version without the advisory GHSA-pgww-w46g-26qg, which the library's own minimum carries. -->
    <PackageReference Include="AngleSharp" Version="1.10.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Respawn.Games.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respawn.Games\Respawn.Games.csproj" />
    <ProjectReference Include="..\..\..\Respawn.SharedKernel\Respawn.SharedKernel.csproj" />
  </ItemGroup>

</Project>
