<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every test project shares: the real app started in-process and the test database. Not a
       test project itself; what only one module needs lives in that module's tests. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respawn.Host\Respawn.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <InternalsVisibleTo Include="Respawn.Tests" />
    <InternalsVisibleTo Include="Respawn.Accounts.Tests" />
  </ItemGroup>

</Project>
