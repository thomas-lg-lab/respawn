root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,slnx}]
indent_size = 2

# Written by the EF Core tools: not formatted, not analysed.
[backend/**/Migrations/*.cs]
generated_code = true
